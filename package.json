{
  "name": "@naghashyan/ngs-builder",
  "version": "2.0.0",
  "description": "Unified NGS CLI for module installation, migrations orchestration, and legacy JS building.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "bin": {
    "ngs": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naghashyan/ngs-builder.git"
  },
  "author": "Naghashyan Solutions",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naghashyan/ngs-builder/issues"
  },
  "homepage": "https://github.com/naghashyan/ngs-builder#readme",
  "dependencies": {
    "@babel/core": "8.0",
    "@babel/plugin-transform-arrow-functions": "8.0",
    "@babel/plugin-transform-modules-systemjs": "8.0",
    "@babel/preset-env": "8.0",
    "commander": "15.0",
    "terser": "5.48"
  },
  "devDependencies": {
    "eslint": "10.5"
  }
}
